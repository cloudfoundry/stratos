{
  "compilerOptions": {
    "outDir": "../../../../dist-devkit",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "types": [
      "node"
    ]
  }
