@tailwind base;
@tailwind components;
@tailwind utilities;

/* Icon font styles - supports both material-icons and custom icon fonts */
.material-icons,
.icon {
  font-weight: normal;
  font-style: normal;
  font-size: 24px;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-smoothing: antialiased;
}

/* CSS Custom Properties for theme customization */
:root {
  /* Brand colors - these will be overridden by StratosThemeService */
  --color-primary: #1e293b;
  --color-secondary: #60a5fa;
  --color-accent: #60a5fa;
  --color-success: #22c55e;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  --color-info: #3b82f6;

  /* Navigation colors - these will be overridden by StratosThemeService */
  --nav-bg: #1e293b;
  --nav-text: #ffffff;
  --nav-text-muted: rgba(255, 255, 255, 0.7);
  --nav-hover: rgba(255, 255, 255, 0.1);
  --nav-active: rgba(255, 255, 255, 0.15);
  --nav-border: rgba(255, 255, 255, 0.1);
  --nav-tooltip: #374151;

  /* Layout colors - these will be overridden by StratosThemeService */
  --app-bg: #f8fafc;
  --body-bg: #f1f5f9;
  --app-text: #1e293b;
  --text-muted: #64748b;
  --header-bg: #ffffff;
  --header-text: #1e293b;
  --header-border: #e2e8f0;
  --content-bg: #ffffff;
  --content-secondary: #f8fafc;
  --content-border: #e2e8f0;
  --content-text: #1e293b;
  --content-muted: #64748b;

  /* Login page */
  --login-bg: #f5f5f5;
  --login-bg-image: url('/core/assets/login-bg.jpg');
  --login-card-bg: #ffffff;

  /* Logo */
  --logo-bg: #ffffff;
}

/* Base layout styles */
* {
  box-sizing: border-box;
}

html {
  @apply h-full;
  background-color: var(--app-bg);
  color: var(--app-text);
}

body {
  @apply h-full m-0 p-0;
  font-family: 'Inter', system-ui, sans-serif;
}

/* Component base styles */
@layer components {
  /* Modern Button System */
  .btn {
    @apply inline-flex items-center justify-center gap-2 px-3.5 py-2 border border-transparent text-sm font-medium rounded-md transition-all duration-200 cursor-pointer;
    @apply focus:outline-none focus:ring-2 focus:ring-offset-2;
    @apply disabled:opacity-50 disabled:cursor-not-allowed disabled:shadow-none;
    line-height: 1.5;
  }

  /* Primary Button */
  .btn-primary {
    @apply text-white shadow-sm;
    background-color: var(--color-primary);
  }

  .btn-primary:hover:not(:disabled) {
    @apply shadow-md;
    background-color: color-mix(in srgb, var(--color-primary) 90%, black);
    transform: translateY(-1px);
  }

  .btn-primary:active:not(:disabled) {
    transform: translateY(0);
  }

  .btn-primary:focus {
    --tw-ring-color: var(--color-primary);
  }

  /* Secondary Button */
  .btn-secondary {
    @apply text-gray-700 bg-white border-gray-300 shadow-sm;
  }

  .btn-secondary:hover:not(:disabled) {
    @apply bg-gray-50 border-gray-400 shadow;
  }

  .btn-secondary:focus {
    --tw-ring-color: var(--color-primary);
  }

  /* Success Button */
  .btn-success {
    @apply text-white shadow-sm;
    background-color: var(--color-success);
  }

  .btn-success:hover:not(:disabled) {
    @apply shadow-md;
    background-color: color-mix(in srgb, var(--color-success) 90%, black);
    transform: translateY(-1px);
  }

  .btn-success:focus {
    --tw-ring-color: var(--color-success);
  }

  /* Warning Button */
  .btn-warning {
    @apply text-white shadow-sm;
    background-color: var(--color-warning);
  }

  .btn-warning:hover:not(:disabled) {
    @apply shadow-md;
    background-color: color-mix(in srgb, var(--color-warning) 90%, black);
    transform: translateY(-1px);
  }

  .btn-warning:focus {
    --tw-ring-color: var(--color-warning);
  }

  /* Danger Button */
  .btn-danger {
    @apply text-white shadow-sm;
    background-color: var(--color-danger);
  }

  .btn-danger:hover:not(:disabled) {
    @apply shadow-md;
    background-color: color-mix(in srgb, var(--color-danger) 90%, black);
    transform: translateY(-1px);
  }

  .btn-danger:focus {
    --tw-ring-color: var(--color-danger);
  }

  /* Info Button */
  .btn-info {
    @apply text-white shadow-sm;
    background-color: var(--color-info);
  }

  .btn-info:hover:not(:disabled) {
    @apply shadow-md;
    background-color: color-mix(in srgb, var(--color-info) 90%, black);
    transform: translateY(-1px);
  }

  .btn-info:focus {
    --tw-ring-color: var(--color-info);
  }

  /* Ghost Button (transparent with border) */
  .btn-ghost {
    @apply bg-transparent border-gray-300 text-gray-700;
  }

  .btn-ghost:hover:not(:disabled) {
    @apply bg-gray-100 border-gray-400;
  }

  /* Outline Variants */
  .btn-outline-primary {
    @apply bg-transparent border-2 text-gray-700;
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .btn-outline-primary:hover:not(:disabled) {
    background-color: var(--color-primary);
    @apply text-white shadow-sm;
  }

  .btn-outline-secondary {
    @apply bg-transparent border-2 border-gray-300 text-gray-700;
  }

  .btn-outline-secondary:hover:not(:disabled) {
    @apply bg-gray-100 border-gray-400;
  }

  /* Icon Buttons */
  .btn-icon {
    @apply rounded-md;
    width: 36px !important;
    height: 36px !important;
    min-width: 36px !important;
    min-height: 36px !important;
    padding: 0.5rem !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .btn-icon-sm {
    @apply rounded-md;
    width: 32px !important;
    height: 32px !important;
    min-width: 32px !important;
    min-height: 32px !important;
    padding: 0.375rem !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  .btn-icon-lg {
    @apply rounded-md;
    width: 44px !important;
    height: 44px !important;
    min-width: 44px !important;
    min-height: 44px !important;
    padding: 0.625rem !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* Button Sizes */
  .btn-sm {
    @apply px-3 py-1.5 text-xs;
  }

  .btn-lg {
    @apply px-6 py-3 text-base;
  }

  /* Button with icon */
  .btn .material-icons,
  .btn .icon {
    font-size: 20px !important;
    width: 20px !important;
    height: 20px !important;
    line-height: 20px !important;
  }

  .btn-icon .material-icons,
  .btn-icon .icon {
    font-size: 20px !important;
    width: 20px !important;
    height: 20px !important;
    line-height: 20px !important;
  }

  .btn-sm .material-icons,
  .btn-sm .icon {
    font-size: 18px !important;
    width: 18px !important;
    height: 18px !important;
  }

  .btn-lg .material-icons,
  .btn-lg .icon {
    font-size: 24px !important;
    width: 24px !important;
    height: 24px !important;
  }

  /* Input styles */
  .input {
    @apply block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:border-transparent;
    --tw-ring-color: var(--color-primary);
  }

  /* Card styles */
  .card {
    @apply bg-white rounded-lg shadow border border-gray-200;
  }

  .card-header {
    @apply px-6 py-4 border-b border-gray-200;
  }

  .card-body {
    @apply px-6 py-4;
  }

  .card-footer {
    @apply px-6 py-4 border-t border-gray-200;
  }

  /* Status indicators */
  .status-success {
    @apply text-white px-2 py-1 rounded-full text-xs font-medium;
    background-color: var(--color-success);
  }

  .status-warning {
    @apply text-white px-2 py-1 rounded-full text-xs font-medium;
    background-color: var(--color-warning);
  }

  .status-danger {
    @apply text-white px-2 py-1 rounded-full text-xs font-medium;
    background-color: var(--color-danger);
  }

  .status-info {
    @apply text-white px-2 py-1 rounded-full text-xs font-medium;
    background-color: var(--color-info);
  }

  /* Navigation styles */
  .nav {
    background-color: var(--nav-bg);
    color: var(--nav-text);
  }

  .nav-item {
    @apply transition-colors duration-200;
  }

  .nav-item:hover {
    background-color: var(--nav-hover);
  }

  .nav-item.active {
    background-color: var(--nav-active);
  }

  /* Navigation utility classes */
  .bg-nav-bg {
    background-color: var(--nav-bg) !important;
  }

  .text-nav-text {
    color: var(--nav-text) !important;
  }

  .text-nav-muted {
    color: var(--nav-text-muted) !important;
  }

  .bg-nav-hover {
    background-color: var(--nav-hover) !important;
  }

  .bg-nav-active {
    background-color: var(--nav-active) !important;
  }
}

/* Legacy Material component support - temporary compatibility layer */
/* These styles will be removed once all components are migrated to Tailwind classes */
.mat-mdc-button,
.mat-mdc-raised-button,
.mat-mdc-flat-button,
.mat-mdc-stroked-button,
.mat-mdc-icon-button {
  @apply btn;
}

.mat-mdc-raised-button.mat-primary,
.mat-mdc-flat-button.mat-primary {
  @apply btn-primary;
}

.mat-mdc-raised-button.mat-accent,
.mat-mdc-flat-button.mat-accent,
.mat-mdc-stroked-button {
  @apply btn-secondary;
}

.mat-mdc-raised-button.mat-warn,
.mat-mdc-flat-button.mat-warn {
  @apply btn-danger;
}

.mat-mdc-icon-button {
  @apply btn-icon;

  .material-icons,
  .icon {
    font-size: 20px !important;
    width: 20px !important;
    height: 20px !important;
  }
}

.border-nav-border {
  border-color: var(--nav-border) !important;
}

.bg-nav-tooltip {
  background-color: var(--nav-tooltip) !important;
}

.bg-accent {
  background-color: var(--color-accent) !important;
}

/* Header styles */
.header {
  background-color: var(--header-bg);
  color: var(--header-text);
}

/* Login page styles */
.login-page {
  background-color: var(--login-bg);
  background-image: var(--login-bg-image);
  @apply bg-cover bg-center min-h-screen;
}

.login-card {
  background-color: var(--login-card-bg);
}

/* Loading spinner */
.spinner {
  @apply inline-block w-4 h-4 border-2 border-solid border-gray-200 border-r-transparent rounded-full animate-spin;
}

.spinner-primary {
  border-color: var(--color-primary);
  border-right-color: transparent;
}

/* Table styles */
.table {
  @apply min-w-full divide-y divide-gray-200;
}

.table th {
  @apply px-6 py-3 bg-gray-50 text-left text-xs font-medium text-gray-500 uppercase tracking-wider;
}

.table td {
  @apply px-6 py-4 whitespace-nowrap text-sm text-gray-900;
}

.table tbody tr {
  @apply even:bg-gray-50;
}

/* List styles */
.list-item {
  @apply border-b border-gray-200 last:border-b-0 hover:bg-gray-50 transition-colors duration-150;
}

/* Progress bar */
.progress {
  @apply w-full bg-gray-200 rounded-full h-2;
}

.progress-bar {
  @apply h-2 rounded-full transition-all duration-300;
  background-color: var(--color-primary);
}

/* Alert styles */
.alert {
  @apply p-4 rounded-md border-l-4;
}

.alert-success {
  @apply bg-green-50 border-green-400 text-green-800;
}

.alert-warning {
  @apply bg-yellow-50 border-yellow-400 text-yellow-800;
}

.alert-danger {
  @apply bg-red-50 border-red-400 text-red-800;
}

.alert-info {
  @apply bg-blue-50 border-blue-400 text-blue-800;
}

/* Modal styles */
.modal-overlay {
  @apply fixed inset-0 bg-black bg-opacity-50 z-50;
}

.modal {
  @apply fixed inset-0 z-50 overflow-y-auto;
}

.modal-container {
  @apply flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0;
}

.modal-panel {
  @apply transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg;
}

/* Tooltip */
.tooltip {
  @apply absolute z-10 invisible px-3 py-2 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300;
}

.tooltip:hover .tooltip-text {
  @apply visible opacity-100;
}

/* Modal styles */
body.modal-open {
  overflow: hidden;
}

/* Primary button with theme colors */
.bg-primary {
  background-color: var(--color-primary) !important;
}

.text-primary {
  color: var(--color-primary) !important;
}

.border-primary {
  border-color: var(--color-primary) !important;
}

.hover\:bg-primary:hover {
  background-color: var(--color-primary) !important;
}

/* Utility classes */
@layer utilities {
  .text-primary {
    color: var(--color-primary);
  }

  .text-secondary {
    color: var(--color-secondary);
  }

  .bg-primary {
    background-color: var(--color-primary);
  }

  .bg-secondary {
    background-color: var(--color-secondary);
  }

  .border-primary {
    border-color: var(--color-primary);
  }

  .border-secondary {
    border-color: var(--color-secondary);
  }

  .focus\:ring-primary:focus {
    --tw-ring-color: var(--color-primary);
  }
}