# =============================================================================
# Stratos E2E Test Configuration
# =============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to project root: cp e2e/secrets.yaml.template secrets.yaml
# 2. Replace all <PLACEHOLDER> values with your actual credentials and URLs
# 3. Get CF GUIDs: cf org e2e --guid && cf space e2e --guid
# 4. Keep this file private (it's in .gitignore)
#
# QUICK START:
# Minimum required fields marked with [REQUIRED]
# Optional fields marked with [OPTIONAL] - tests will skip if not configured
#
# =============================================================================

# =============================================================================
# Stratos Console Users [REQUIRED]
# =============================================================================
consoleUsers:
  admin:
    username: <STRATOS_ADMIN_USERNAME>     # Usually: admin
    password: <STRATOS_ADMIN_PASSWORD>     # Set during Stratos setup
  nonAdmin:
    username: <STRATOS_USER_USERNAME>      # Usually: user
    password: <STRATOS_USER_PASSWORD>      # Set during Stratos setup

# =============================================================================
# Cloud Foundry Endpoints [REQUIRED]
# =============================================================================
endpoints:
  cf:
  - name: cf                                # Display name (can be anything)
    url: <CF_API_URL>                       # Example: https://api.cf.example.com
    skipSSLValidation: true                 # true for self-signed certs

    # Test Organization and Space [REQUIRED]
    # Create with: cf create-org e2e && cf create-space e2e -o e2e
    testOrg: e2e                            # Test org name
    testOrgGuid: <ORG_GUID>                 # Get with: cf org e2e --guid
    testSpace: e2e                          # Test space name
    testSpaceGuid: <SPACE_GUID>             # Get with: cf space e2e --guid

    # Test Service [OPTIONAL] - For service binding tests
    # testService: local-volume

    # Cloud Foundry Credentials [REQUIRED]
    creds:
      admin:
        username: <CF_ADMIN_USERNAME>       # CF admin user
        password: <CF_ADMIN_PASSWORD>       # CF admin password
      nonAdmin:
        username: <CF_USER_USERNAME>        # CF regular user
        password: <CF_USER_PASSWORD>        # CF user password

      # User for removal tests [OPTIONAL]
      # Create with: cf create-user e2e-remove-user <password>
      # removeUser:
      #   username: e2e-remove-user
      #   password: <REMOVE_USER_PASSWORD>

    # Service Marketplace Configuration [OPTIONAL]
    # Required for marketplace tests - skip section if not testing services
    # services:
    #   bindApp: <APP_NAME_FOR_BINDING>     # Existing app for binding tests
    #   publicService:
    #     name: <PUBLIC_SERVICE_NAME>       # e.g., redis, mysql
    #   privateService:
    #     name: <PRIVATE_SERVICE_NAME>      # Private broker service
    #     invalidOrgName: <OTHER_ORG>       # Org without access
    #     invalidSpaceName: <OTHER_SPACE>   # Space without access
    #   spaceScopedService:
    #     name: <SPACE_SCOPED_SERVICE>      # Space-scoped service
    #     invalidOrgName: <OTHER_ORG>
    #     invalidSpaceName: <OTHER_SPACE>

    # User Invitation Configuration [OPTIONAL]
    # Required for user invitation tests
    # invite:
    #   clientId: <INVITE_CLIENT_ID>        # UAA client for invitations
    #   clientSecret: <INVITE_CLIENT_SECRET>

    # UAA Configuration [OPTIONAL]
    # Required for SSO and advanced user management tests
    # uaa:
    #   creds:
    #     clientId: <UAA_CLIENT_ID>
    #     clientSecret: <UAA_CLIENT_SECRET>
    #   tokenEndpoint: <UAA_URL>            # e.g., https://uaa.cf.example.com
    #   zone: <UAA_ZONE>                    # Usually: uaa

# =============================================================================
# Test Configuration
# =============================================================================
skipSSLValidation: true                     # Skip SSL for Stratos backend
headless: false                             # false = see browser, true = CI mode

# =============================================================================
# NOTES:
# =============================================================================
#
# Getting GUIDs:
#   cf org e2e --guid      -> testOrgGuid
#   cf space e2e --guid    -> testSpaceGuid
#   cf app test-app --guid -> for service binding tests
#
# Creating Test Resources:
#   cf create-org e2e
#   cf create-space e2e -o e2e
#   cf target -o e2e -s e2e
#
# Setting Up Users:
#   cf create-user cf-user <password>
#   cf set-space-role cf-user e2e e2e SpaceDeveloper
#   cf set-org-role cf-user e2e OrgUser
#
# Verifying Setup:
#   cf target -o e2e -s e2e
#   cf apps
#   cf services
#   cf domains
#
# Running Tests:
#   bunx playwright test e2e/tests/
#   bunx playwright test e2e/tests/cloud-foundry/space-level/
#   bunx playwright test --ui
#
# =============================================================================
