{
  "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/frontend/packages/**/*.ts"],
    "ignoreUnknown": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn",
        "noEmptyBlockStatements": "warn"
      },
      "style": {
        "useConst": "warn"
      },
      "complexity": {
        "noUselessTypeConstraint": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "off"
      }
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
