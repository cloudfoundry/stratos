{
  "version": 2,
  "id": "login",
  "name": "Login",
  "mappings": [
    { "selector": ".login-container", "snapshotId": "auth.login.page",
      "tokens": [{ "name": "--color-brand-50" }],
      "description": { "ref": "auth.login.page" } },
    { "selector": ".login-card", "snapshotId": "auth.login.page.card",
      "tokens": [{ "name": "--color-brand-50" }, { "name": "--color-brand-200" }],
      "description": { "ref": "auth.login.page.card" } },
    { "selector": ".login-card h1", "snapshotId": "auth.login.page.card.title",
      "tokens": [{ "name": "--color-brand-900" }],
      "locator": { "role": "heading", "name": "Sign in to Stratos" } },
    { "selector": ".login-card label", "snapshotId": "auth.login.page.card.username-label",
      "tokens": [{ "name": "--color-brand-800" }],
      "locator": { "role": "label", "name": "Username" } },
    { "selector": ".login-card input", "snapshotId": "auth.login.page.card.username",
      "tokens": [{ "name": "--color-brand-300" }],
      "locator": { "role": "textbox", "name": "Username" } },
    { "selector": ".btn-primary", "snapshotId": "auth.login.page.card.sign-in",
      "tokens": [{ "name": "--color-brand-500" }],
      "locator": { "role": "button", "name": "Sign in" } },
    { "selector": ".login-bg", "snapshotId": "auth.login.page.background", "tokens": [],
      "locator": { "role": "img", "name": "background image for the login page" } },
    { "selector": ".login-logo", "snapshotId": "auth.login.page.card.logo", "tokens": [],
      "locator": { "role": "img", "name": "logo image for the login page" } },
    { "selector": ".login-subtitle", "snapshotId": "auth.login.page.card.subtitle", "tokens": [],
      "locator": { "role": "paragraph", "name": "subtitle" } },
    { "selector": ".login-message", "snapshotId": "auth.login.page.card.message", "tokens": [],
      "locator": { "role": "note", "name": "custom message" } }
  ]
}
