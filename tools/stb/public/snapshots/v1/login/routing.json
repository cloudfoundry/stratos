{
  "containers": { "auth.login": "login" },
  "elements": {
    "auth.login.page":        { "config": "backgroundColor" },
    "auth.login.page.card":        { "config": "cardBackground" },
    "auth.login.page.card.title":       { "config": "title", "visibilityConfig": "showTitle" },
    "auth.login.page.card.subtitle":    { "config": "subtitle" },
    "auth.login.page.card.message":     { "config": "customMessage" },
    "auth.login.page.card.logo":        { "config": "logos.main", "visibilityConfig": "showLogo" },
    "auth.login.page.background":  { "config": "logos.loginBackground" },
    "auth.login.page.card.sign-in":     { "config": "theme.primary" },
    "auth.login.page.error":       { "config": "theme.danger" },
    "auth.login.page.card.username":    { "config": "inputBorder" },
    "auth.login.page.card.password":    { "config": "inputBorder" }
  }
}
