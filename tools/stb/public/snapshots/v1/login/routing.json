{
  "containers": { "auth.login": "login" },
  "elements": {
    "auth.login.page":        { "config": "backgroundColor" },
    "auth.login.card":        { "config": "cardBackground" },
    "auth.login.title":       { "config": "title", "visibilityConfig": "showTitle" },
    "auth.login.subtitle":    { "config": "subtitle" },
    "auth.login.message":     { "config": "customMessage" },
    "auth.login.logo":        { "config": "logos.main", "visibilityConfig": "showLogo" },
    "auth.login.background":  { "config": "logos.loginBackground" },
    "auth.login.sign-in":     { "config": "theme.primary" },
    "auth.login.error":       { "config": "theme.danger" },
    "auth.login.username":    { "config": "inputBorder" },
    "auth.login.password":    { "config": "inputBorder" }
  }
}
